# The docs site is served under a subpath rather than at the root of its own
# origin: GitHub Pages serves it at /tidebreak/docs/. Set BASE_PATH to that
# subpath when building so asset URLs, links, and the client-side search index
# resolve.
#
# Leave it unset for local development (`pnpm dev` serves at http://localhost:3000/).
# BASE_PATH=/tidebreak/docs
